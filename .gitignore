/bin
/obj
*/bin
*/obj
*/bin
/tmp
/out-tsc

# Only exists if Bazel was run
/bazel-out

# dependencies
/node_modules

# profiling files
chrome-profiler-events*.json

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

API/wwwroot/

BaseAPI/wwwroot/

*.bak
.vs/
.vscode/
.aspnet/
WebClient/.angular/

bin/
obj/

.angular/

# Working notes — must never be committed
PORTFOLIO-PLAN.md
BUILD-PLAN.md
GETTING-STARTED.md

# secrets — templates are committed, real values never are
**/appsettings.Local.json
**/appsettings.Production.json
**/Common.env
*.env
!*.env.template
!**/Common.env.template

# dev certs and keys
**/ssl/*.key
**/ssl/*.pem
**/ssl/*.pfx
*.pfx

# Angular build output. `/dist` above is root-relative and did not cover this one.
src/API.Web/ClientApp/dist/
src/API.Web/ClientApp/out-tsc/

# per-developer project state
*.*proj.user
