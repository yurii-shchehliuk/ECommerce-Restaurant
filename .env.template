# Copy to .env and set real values. .env is gitignored.
# Used by docker-compose.

# SQL Server SA account. Must satisfy SQL Server complexity policy:
# 8+ chars, three of: uppercase, lowercase, digit, symbol.
SA_PASSWORD=REPLACE_ME_strong_password

# Application login created by sql/InitializeOwletDb.sql (only used by the
# sql/sql.Dockerfile image, which is an alternative to the stock mssql image).
OWLET_DBUSER_PASSWORD=REPLACE_ME_strong_password
