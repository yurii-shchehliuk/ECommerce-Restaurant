<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<TargetFramework>net6.0</TargetFramework>
		<UserSecretsId>82754558-fabb-4b3e-ad5e-78c553fc4b3a</UserSecretsId>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
		<DockerComposeProjectPath>..\..\docker-compose.dcproj</DockerComposeProjectPath>
		<DockerfileContext>..\..</DockerfileContext>
		<!--
		  The Angular client is built by the Angular CLI (`ng build`), in the node stage
		  of src/API.Web/Dockerfile. It is deliberately NOT built by MSBuild: the
		  Microsoft.TypeScript.MSBuild package that used to be referenced here ran `tsc`
		  over ClientApp on every `dotnet build`, which failed with
		  "TS2688: Cannot find type definition file for 'jasmine'" on any machine that
		  had not run `npm install` first — i.e. on a clean clone, which is the only
		  state that matters. `dotnet build Owlet.sln` now succeeds with no Node.js
		  installed at all.
		-->
		<TypeScriptCompileBlocked>true</TypeScriptCompileBlocked>
		<DefaultItemExcludes>$(DefaultItemExcludes);ClientApp\node_modules\**;ClientApp\dist\**</DefaultItemExcludes>
	</PropertyGroup>
	<ItemGroup>
		<Compile Remove="Content\**" />
		<Content Remove="Content\**" />
		<EmbeddedResource Remove="Content\**" />
		<None Remove="Content\**" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.17.0" />
		<PackageReference Include="Serilog.AspNetCore" Version="6.1.0" />
		<PackageReference Include="Serilog.Sinks.Seq" Version="5.2.2" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\WebApi.Domain\WebApi.Domain.csproj" />
		<ProjectReference Include="..\WebApi.Infrastructure\WebApi.Infrastructure.csproj" />
	</ItemGroup>
</Project>
