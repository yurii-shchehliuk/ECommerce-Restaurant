# Copy this file to Common.env and fill in real values.
# Common.env is gitignored and must never be committed.
#
# docker-compose.yml loads this into every service, so the four services share one
# signing key by construction rather than by four copies of it agreeing.
#
# Note what is NOT here any more: the connection strings. docker-compose.yml builds
# those from SA_PASSWORD in .env, so the database password exists in exactly one
# place. Having it in .env AND in two connection strings here was three chances to
# get it wrong, and the resulting login failure looked like a schema problem.

# Token__Key must be at least 64 bytes / 512 bits: TokenService signs with HS512,
# and RFC 7518 s3.2 requires a key at least as large as the algorithm's hash output.
# Generate one with:
#   openssl rand -base64 64
#   [Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(64))   # PowerShell
Token__Key=REPLACE_ME-generate-with-openssl-rand-base64-64-this-value-is-not-a-secret

# Must be identical everywhere: API.Identity signs with it, the others validate against it.
Token__Issuer=http://localhost:5200

# Stripe test-mode secret key. Only the checkout path needs it; everything else works
# without one. There is deliberately no default — the code fails fast instead.
# StripeSettings__SecretKey=sk_test_replace_me
