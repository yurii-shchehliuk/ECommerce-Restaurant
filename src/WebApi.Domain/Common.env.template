# Copy this file to Common.env and fill in real values.
# Common.env is gitignored and must never be committed.
#
# Token__Key must be at least 64 bytes / 512 bits: TokenService signs with HS512,
# and RFC 7518 s3.2 requires a key at least as large as the algorithm's hash output.
# Generate one with:
#   openssl rand -base64 64
#   [Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(64))   # PowerShell
Token__Key=REPLACE_ME-generate-with-openssl-rand-base64-64-this-value-is-not-a-secret
ConnectionStrings__DefaultConnection=server=owletsql;Database=appdb;User Id=sa;Password=REPLACE_ME;MultipleActiveResultSets=true;
ConnectionStrings__IdentityConnection=server=owletsql;Database=identitydb;User Id=sa;Password=REPLACE_ME;MultipleActiveResultSets=true;
