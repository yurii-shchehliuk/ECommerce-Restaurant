<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ImplicitUsings>true</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- The repo targets net6.0, which is EOL; roll forward so the test host runs on
         a newer installed runtime when the 6.0 ASP.NET runtime is absent. -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <!-- AddMassTransitTestHarness lives in the main MassTransit package (8.x); the
         separate MassTransit.TestFramework package pulls in NUnit and is not needed. -->
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="6.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="6.0.10" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.1.0" />
    <PackageReference Include="xunit" Version="2.4.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.4.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="3.2.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\API.Basket\API.Basket.csproj" />
    <ProjectReference Include="..\..\src\EventBus.Messages\EventBus.Messages.csproj" />
    <ProjectReference Include="..\..\src\WebApi.Db.Store\WebApi.Db.Store.csproj" />
    <ProjectReference Include="..\..\src\WebApi.Domain\WebApi.Domain.csproj" />
    <ProjectReference Include="..\..\src\WebApi.Infrastructure\WebApi.Infrastructure.csproj" />
  </ItemGroup>

</Project>
